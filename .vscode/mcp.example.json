{
  "servers": {
    "play-listings": {
      "type": "stdio",
      "command": "node",
      "args": ["dist/index.js"],
      "env": {
        "PLAY_KEY_FILE": "C:\\Users\\<username>\\.secrets\\play-key.json",
        "PLAY_ALLOWED_PACKAGES": "no.example.app1,no.example.app2",
        "PLAY_ENABLE_APPLY": "false"
      }
    }
  }
}
